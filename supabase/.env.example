# Copy to `supabase/.env` and fill in. That file is gitignored — never commit secrets.
#
#     cp supabase/.env.example supabase/.env
#     supabase stop && supabase start        # picks up the new values
#
# These are substituted into supabase/config.toml wherever it says env(NAME).
#
# ---------------------------------------------------------------------------
# GitHub — https://github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://127.0.0.1:54321/auth/v1/callback
# ---------------------------------------------------------------------------
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=

# ---------------------------------------------------------------------------
# Google — https://console.cloud.google.com/apis/credentials
#   → Create Credentials → OAuth client ID → Web application
#   Authorized redirect URI:    http://127.0.0.1:54321/auth/v1/callback
# ---------------------------------------------------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
