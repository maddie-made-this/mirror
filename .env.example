# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
#     cp .env.example .env
#
# Used by docker-compose.yml to provision the local Neo4j container. Choose any
# value; the backend must use the SAME one (see backend/.env.example).
#
# NOTE: Neo4j bakes the password into its data volume on FIRST start. If you
# change this later, either reuse the original value or reset the volume:
#     docker compose down -v
NEO4J_PASSWORD=change-me
