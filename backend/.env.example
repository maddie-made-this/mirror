# Copy this file to `backend/.env` and fill in real values. `.env` is gitignored.
#
#     cp backend/.env.example backend/.env

# --- Data stores (must match the root .env used by docker-compose) ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Supabase (local dev defaults) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- LLM providers ---
# Required for the app to start. The test suite mocks the LLM, so placeholder
# values are fine for running tests.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Model tiers (optional; sensible defaults are committed) ---
# The frontier tier (director, renderer, response generation) defaults to
# anthropic/claude-sonnet-5. UTILITY_MODEL repoints the whole cheap tier —
# extraction, angle matcher, headline, reflection — in one lever; unset, those
# roles also fall back to the frontier model. Per-role overrides:
# EXTRACTION_MODEL / MATCHER_MODEL / HEADLINE_MODEL. RESPONSE_MODEL / DIRECTOR_MODEL
# / RENDERER_MODEL repoint the frontier roles. Embeddings are set in config
# (text-embedding-3-small), not here.
UTILITY_MODEL=anthropic/claude-haiku-4.5
