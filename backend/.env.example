# Copy this file to `backend/.env` and fill in real values. `.env` is gitignored.
#
#     cp backend/.env.example backend/.env
#
# This is the ONE env file for local infrastructure + backend: docker-compose
# reads it too (`docker compose --env-file backend/.env up -d`), so the Neo4j
# password lives in exactly one place. Compose only substitutes ${variables} in
# docker-compose.yml from it — the API keys below are never injected into any
# container.

# --- Data stores ---
# NOTE: Neo4j bakes the password into its data volume on FIRST start. If you
# change it later, either keep the original value or reset the volume:
#     docker compose down -v
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Supabase (local dev defaults) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- LLM providers ---
# Required for the app to start. The test suite mocks the LLM, so placeholder
# values are fine for running tests.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Model roles, one var each ---
# Two fallback chains, separate by construction: the frontier roles fall back to
# the committed llm_model, the cheap roles fall back through UTILITY_MODEL — so
# repointing the cheap tier can never downgrade generation. Only UTILITY_MODEL
# strictly needs setting; the rest are written out so this file shows the full
# routing at a glance. Embeddings are set in config (text-embedding-3-small),
# not here — changing that model means a re-embed and a new collection.
RESPONSE_MODEL=anthropic/claude-sonnet-5
DIRECTOR_MODEL=anthropic/claude-sonnet-5
RENDERER_MODEL=anthropic/claude-sonnet-5
UTILITY_MODEL=anthropic/claude-haiku-4.5
EXTRACTION_MODEL=anthropic/claude-haiku-4.5
MATCHER_MODEL=anthropic/claude-haiku-4.5
HEADLINE_MODEL=anthropic/claude-haiku-4.5
