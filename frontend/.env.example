# Copy this file to `frontend/.env.local` and fill in real values.
# `.env.local` is gitignored.
#
#     cp frontend/.env.example frontend/.env.local

# The FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Supabase. Run `supabase start` from the repo root; it prints the API URL
# and the publishable/anon key to paste here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional generation surface. 0 = off (default).
NEXT_PUBLIC_APP_MODE=0

# The "why did that land?" analytic-branch chip. Off by default: the fork works
# but lands on a generic opener rather than one framed around the piece, so it's
# held back until that UX is finished. 1 = on. (?whyland=1 also enables it ad hoc.)
NEXT_PUBLIC_ENABLE_ANALYTIC_BRANCH=0

# Editing your own past messages. Off by default: the edit is currently local-only
# and does not survive a refresh, so it can't yet deliver the durable privacy
# scrub it implies. 1 = on. (?edit=1 also enables it ad hoc.)
NEXT_PUBLIC_ENABLE_MESSAGE_EDIT=0
